# Somente valores públicos para o ambiente local. Copie para .env.local e nunca versione segredos.
VITE_APP_ENV=development
VITE_CLUB_DEPLOYMENT_ID=mbj-local
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Opcional e usado somente no domínio canônico de produção.
VITE_ONESIGNAL_APP_ID=
# O DSN é público, mas só deve ser configurado em staging/produção.
VITE_SENTRY_DSN=
# Injetado automaticamente a partir do SHA do deployment.
VITE_SENTRY_RELEASE=
